# Copie ce fichier vers .env et remplis les valeurs.
# Local : fichier .env à la racine du projet (lu par bacia/settings.py via python-dotenv).
# Railway : Project → Variables → ajoute les mêmes clés (pas de fichier .env sur le serveur).

SECRET_KEY=change-me-generate-with-django-get-random-secret-key

# DeepSeek — IA principale (cours, exercices, chat)
# Obtenir une clé : https://platform.deepseek.com/api_keys
# API : base_url https://api.deepseek.com — modèles deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=

# Coût IA — ne PAS activer le Pro (thinking high ≈ 350k tokens/requête)
# AI_ALLOW_PRO=false
# AI_DISABLE_THINKING=true
# AI_MAX_OUTPUT_TOKENS=2000
# MAX_GLOBAL_TOKENS_PER_DAY=1500000
# AI_USAGE_LOG=true
# Tarifs Flash (USD / million tokens) — page admin IA
# AI_PRICE_INPUT_PER_M=0.14
# AI_PRICE_OUTPUT_PER_M=0.28
# AI_PRICE_CACHE_HIT_PER_M=0.0028

# Optionnel
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Dev local rapide : ignore DATABASE_URL (PostgreSQL distant) et utilise db.sqlite3
# USE_LOCAL_DB=1

# Firebase Cloud Messaging (push)
# FIREBASE_CREDENTIALS_PATH=credentials/htbac-d22cb-firebase-adminsdk.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_VAPID_KEY=
# PUBLIC_BASE_URL=https://outoubon.com

# MonCash Connect (paiement) — https://api.moncashconnect.com/v1
# La clé secrète et le secret webhook sont SENSIBLES : à mettre dans les Secrets,
# jamais dans le code. La clé publique (pk_...) n'est pas sensible.
# MONCASH_API_URL=https://api.moncashconnect.com/v1
# MONCASH_PUBLIC_KEY=pk_proj_xxx
MONCASH_SECRET_KEY=
MONCASH_WEBHOOK_SECRET=

